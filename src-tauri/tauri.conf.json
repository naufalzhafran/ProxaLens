{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProxaLens",
  "version": "../package.json",
  "identifier": "dev.naufalzhafran.proxalens",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ProxaLens",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGQTg3OTQwQjA2MzgyMUIKUldRYmdtT3dRSG1vVDFqMlYyc24wRXZNVWxsR0hLRzZJaC8yeTBVUkpHOWtxWWdISFpGRjBHbWwK",
      "endpoints": [
        "https://github.com/naufalzhafran/ProxaLens/releases/latest/download/latest.json"
      ]
    }
  }
}
